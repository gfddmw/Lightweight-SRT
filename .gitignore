# 忽略 PyTorch 模型权重
*.pt
*.pth
*.ckpt
*.pptx

# 忽略存文件夹
mytools/
checkpoints/
weights/
**/weights/
**/checkpoints/
**/mytools/

# 忽略数据文件夹 (如果之前没加)
data/
.idea/
test/
androidTest/

# 1. Gradle 缓存与构建产物 (必须忽略)
.gradle/
/build/
*/build/

# 2. 本地环境配置文件 (必须忽略，包含你电脑上的 SDK 路径，不能共享)
local.properties

# 3. Android Studio / IntelliJ IDEA 配置文件 (必须忽略)
.idea/
*.iml
*.iws
*.ipr
*.xml
*.kts
*.pro
*.properties

# 4. 操作系统生成的临时文件
.DS_Store
Thumbs.db
*.bak
*.tmp

# 5. 签名与打包秘钥 (⚠️ 安全极度重要：绝对不能把签名文件传到 Git)
*.jks
*.keystore
signing.properties
key.properties

# 6. C/C++ 编译产物 (如果你们后续加入 NDK 或底层 C++ 代码)
.cxx/
*.obj
*.so
*.a
*.dll

# 7. 测试报告
/app/build/reports/
